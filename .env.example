# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Твій Telegram ID (бот покаже його, якщо написати /start без цього параметра)
OWNER_ID=
# Часовий пояс і час ранкового списку дедлайнів
TIMEZONE=Europe/Kyiv
DIGEST_TIME=09:00
# За скільки годин до дедлайну надсилати друге нагадування
SOON_HOURS=3
DB_PATH=tasks.db
