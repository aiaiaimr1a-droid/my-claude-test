# --- Обязательное ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID платного канала с заказами (бот должен быть в нём админом). Формат -100...
PAID_CHANNEL_ID=-1001234567890

# Сколько авторов могут открыть контакт одного заказа
CONTACT_LIMIT=5

# Ваш Telegram ID (через запятую, если админов несколько). Узнать: @userinfobot
ADMIN_IDS=111111111

# Ссылка на оформление подписки (Stars-ссылка канала, бот оплаты и т.п.)
SUBSCRIBE_URL=https://t.me/+xxxxxxxxxxxx

# --- Бесплатный канал-витрина (необязательно) ---
# Если задан, заказы дублируются туда с задержкой, без контактов и бюджета
FREE_CHANNEL_ID=
FREE_DELAY_MINUTES=240

# --- Прочее ---
DB_PATH=orders.sqlite3
# Окно, в котором одинаковый текст считается дублем (часы)
DEDUP_HOURS=72

# --- Юзербот (необязательно) ---
# Нужен, чтобы читать группы, куда нельзя добавить бота.
# api_id / api_hash берутся на https://my.telegram.org -> API development tools
API_ID=
API_HASH=
USERBOT_SESSION=userbot
# Какие чаты слушать: @username или -100... через запятую. Пусто = все группы аккаунта
USERBOT_CHATS=

# Публичные группы, которые читаем БЕЗ вступления (@username через запятую).
# Найти их: python -m bot.find_groups "КПІ" "студенти"
USERBOT_PUBLIC_CHATS=
# Как часто проверять публичные группы (секунды)
USERBOT_POLL_SECONDS=180
